# Google Ads conversion tracking
# Get this value from: Google Ads > Ferramentas e Configurações > Conversões >
# "Enviar formulário de lead" > Ver snippet de evento. Copy only the part
# after "AW-17944651982/" in the send_to field.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chatwoot
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_TOKEN=
